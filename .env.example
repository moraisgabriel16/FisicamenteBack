# Docker Compose reads .env. Local Python reads environment variables set in PowerShell.
POSTGRES_PASSWORD=replace-with-a-random-password
APP_URL=http://127.0.0.1:5186
APP_ENV=development
# Generate: ./.venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
